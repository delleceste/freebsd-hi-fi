#!/usr/bin/env bash
# Launch Google Chrome with BruteFIR bypassed for correct A/V sync.
# Restores DRC when the browser exits.
# Binary name: google-chrome-stable (Arch Linux), google-chrome (other distros)

BROWSER=google-chrome-stable
DRC=/home/giacomo/DRC/brutefir-conf/drc.sh

if pgrep -xi "$BROWSER" > /dev/null 2>&1; then
    echo "Browser already running — DRC will NOT be toggled." >&2
    exec "$BROWSER" "$@"
fi

"$DRC" off
"$BROWSER" "$@"
"$DRC" restore
