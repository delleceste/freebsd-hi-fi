#!/usr/bin/env bash
# Launch Firefox with BruteFIR bypassed for correct A/V sync.
# --no-remote forces a new instance that blocks until the window closes,
# enabling reliable DRC restore on exit regardless of existing Firefox sessions.

DRC=/home/giacomo/DRC/brutefir-conf/drc.sh

"$DRC" off
firefox --no-remote "$@"
"$DRC" restore
